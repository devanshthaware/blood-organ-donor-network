# ==============================================================================
# VEINLINK HEALTHCARE RESOURCE NETWORK — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development. NEVER COMMIT SECRETS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & IDENTITY (CLERK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_WEBHOOK_SECRET=whsec_placeholder_secret

# ------------------------------------------------------------------------------
# 2. PRIMARY SYSTEM OF RECORD (CONVEX)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://placeholder-instance.convex.cloud
CONVEX_DEPLOYMENT=dev:placeholder-instance

# ------------------------------------------------------------------------------
# 3. AI & MACHINE LEARNING INFERENCE (FASTAPI)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ML_API_URL=http://localhost:8000
ML_SERVICE_SECRET=ml_internal_sec_placeholder
ML_MODEL_CACHE_DIR=/tmp/veinlink_models

# ------------------------------------------------------------------------------
# 4. COMPUTER VISION & OCR SERVICE
# ------------------------------------------------------------------------------
CV_SERVICE_URL=http://localhost:8000/ocr
CV_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 5. EVENT AUTOMATION & WORKFLOWS (n8n)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/veinlink-events
N8N_HMAC_SECRET=veinlink_n8n_hmac_secret_key_2026

# ------------------------------------------------------------------------------
# 6. BLOCKCHAIN TRUST & PROVENANCE LAYER
# ------------------------------------------------------------------------------
BLOCKCHAIN_NETWORK=SIMULATED_TESTNET
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
BLOCKCHAIN_MERKLE_BATCH_SIZE=64

# ------------------------------------------------------------------------------
# 7. MAPS & GEOLOCATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token
MAP_DEFAULT_LAT=18.5204
MAP_DEFAULT_LNG=73.8567

# ------------------------------------------------------------------------------
# 8. NOTIFICATIONS & OUTREACH
# ------------------------------------------------------------------------------
NOTIFICATION_PROVIDER=MOCK_SIMULATION
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=auth_token_placeholder

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & SYSTEM AUDIT
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_DEMO_MODE=true
ENABLE_ZERO_PHI_ENFORCEMENT=true
